# Banco de dados (PostgreSQL via docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=med_app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/med_app

# Supabase (Storage + Auth)
# SUPABASE_SECRET_KEY (formato sb_secret_...) é segredo — nunca commitar o valor real.
# Aceita também o legado SUPABASE_SERVICE_ROLE_KEY como fallback.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=uploads
# Auth: validação do JWT do Supabase (chaves assimétricas).
SUPABASE_JWKS_URL=

# Anthropic (geração de flashcards via IA) — ANTHROPIC_API_KEY é segredo.
ANTHROPIC_API_KEY=
# Opcional: sobrescreve o modelo padrão (claude-opus-4-8), ex.: claude-haiku-4-5
ANTHROPIC_MODEL=
